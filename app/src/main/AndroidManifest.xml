<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮窗：用于把识别结果贴在屏幕上方（用户主动授权） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务：MediaProjection 截屏 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 13+ 通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="词拍 WordSnap"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.TrainingActivity" android:exported="false" />
        <activity android:name=".ui.WordBookActivity" android:exported="false" />
        <activity android:name=".ui.SolverActivity" android:exported="false" />

        <activity
            android:name=".ui.ResultActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".capture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 实时答题链路：截屏 -> OCR -> 解析 -> 融合，只展示不点击 -->
        <service
            android:name=".capture.QuizCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 自动作答（可选）。必须用户手动在系统无障碍设置里打开，
             且 App 内总开关 + 包名白名单同时满足才工作，默认完全不动作。 -->
        <service
            android:name=".service.AutoAnswerService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
